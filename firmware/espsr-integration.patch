+    boards/sdkconfig.240mhz
+    boards/sdkconfig.spiram_oct
+    boards/ESP32_GENERIC_S3/sdkconfig.sr
+)
+
+list(APPEND MICROPY_DEF_BOARD
+    MICROPY_HW_BOARD_NAME="Generic ESP32S3 module with Octal-SPIRAM and ESP-SR"
+)
+
